# Site packages / virtual environments — never commit dependencies
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Any top-level site-packages directory
site-packages/

# Atlas proxy API keys — keep credentials private
openroute_keys.txt

# Local environment file — holds machine-specific config and secrets
.env
.env.*
!.env.example

# Python bytecode cache (auto-generated on import; never commit)
__pycache__/
*.pyc
*.pyo

# Editor swap/backup files — never commit
*.swp
*.swo
*~

# Installer log (debugging artifact; lives per-install dir)
.installer.log

# Runtime logs — written continuously by the running proxy, never source
data/run.log
proxy/logs/
*.log

# Runtime state — per-install, machine-specific
data/run.pid
data/proxy_data/
data/runtime.json
data/startup.log

# Local caches
.cache/

.windows-installer-backup-*/
.backup_sudo_free/
.plugin-config/
.session-summary.md

# --- Dashboard (added with the management UI) ---
# Runtime state: SQLite DB holds the admin password hash and live sessions.
data/dashboard/
data/dashboard.pid
data/dashboard.log
data/dashboard/
dashboard/.impeccable/review/
artifacts/

# Node / build output
dashboard/web/node_modules/
dashboard/web/dist/
dashboard/web/.vite/
dashboard/.impeccable/

# TypeScript incremental build cache
tsconfig.tsbuildinfo

# --- Local documentation ---
# Working notes and design docs stay out of the repo (removed in 22de889).
docs/

# Host-specific deploy files — reference this machine's live nginx config,
# real IPs and cert paths. Tracked templates use SERVER_HOST placeholders.
dashboard/deploy/nginx-live.conf
dashboard/deploy/*.disabled
.bak*
