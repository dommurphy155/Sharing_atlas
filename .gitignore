# Site packages / virtual environments — never commit dependencies
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Any top-level site-packages directory
site-packages/

# Atlas proxy API keys — keep credentials private
openroute_keys.txt

# Python bytecode cache (auto-generated on import; never commit)
__pycache__/
*.pyc
*.pyo

# Editor swap/backup files — never commit
*.swp
*.swo
*~
