# ──────────────────────────────────────────────────────────────────────
# Atlas Proxy — configuration reference
# Copy to .env and fill in what you need.
# All values are overridable via environment variables.
# ──────────────────────────────────────────────────────────────────────

# ── Proxy base URL (used by the CLI for health checks) ──
ATLAS_PROXY_URL=http://127.0.0.1:8000

# ── Command name for this fork (default: atlas) ──
# Set to atlas_2 or another name if running alongside another Atlas instance.
ATLAS_CMD_NAME=atlas

# ── Provider selection ──
# openrouter  (default) — uses OpenRouter keys from KEY_FILE
# nvidia      — uses NVIDIA keys from NV_KEY_FILE, partial_sticky pool
ATLAS_PROVIDER=openrouter

# ── Runtime config (written by the Atlas CLI wizard) ──
# These paths are resolved at import time from the proxy package location,
# but can be overridden here if you know what you're doing.
# RUNTIME_PROVIDER_FILE=data/proxy_data/runtime_provider.json
# SYSTEM_PROMPT_OVERRIDE_FILE=data/proxy_data/prompt_override.txt

# ── Default models ──
ATLAS_OPENROUTER_MODEL=poolside/laguna-s-2.1:free
ATLAS_NV_MODEL=nvidia/llama-3.3-70b-instruct

# ── Model override (force provider default, ignoring client-sent model) ──
# Global flag (default: True). Per-provider flags take precedence when set.
FORCE_DEFAULT_MODEL=1
FORCE_DEFAULT_MODEL_OR=              # ← inherits from global when unset
FORCE_DEFAULT_MODEL_NV=              # ← inherits from global when unset

# ── Key files ──
# OpenRouter keys (one per line, sk-... prefix)
ATLAS_OPENROUTER_KEYS_FILE=/root/atlas/data/openrouter_data/openroute_keys.txt
# NVIDIA keys (one per line, nvapi- prefix)
ATLAS_NV_KEYS_FILE=/root/atlas/data/nvda_data/keys.txt
ATLAS_NV_DEAD_KEYS_FILE=/root/atlas/data/nvda_data/dead_keys.txt
# Fallback OR key file (used when primary is empty)
FALLBACK_KEY_FILE=/root/atlas/data/openrouter_data/openroute_keys.txt

# ── Server ──
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8000

# ── Python runtime ──
# Don't emit .pyc / __pycache__ — keeps the working tree clean.
PYTHONDONTWRITEBYTECODE=1

# ── Connection pool / timeouts ──
MAX_CONNECTIONS=200
MAX_KEEPALIVE_CONNECTIONS=100
KEEPALIVE_EXPIRY=60.0
CONNECT_TIMEOUT=15.0
READ_TIMEOUT=600.0     # long agent turns
WRITE_TIMEOUT=300.0
POOL_TIMEOUT=30.0

# ── Key health ──
ATLAS_PROXY_COOLDOWN_SECONDS=45.0
COOLDOWN_MAX_SECONDS=300.0
ATLAS_PROXY_MAX_ERRORS=8
SUSPEND_SECONDS=600.0
HEALTH_CHECK_INTERVAL=60.0
PREWARM_INTERVAL=300.0

# ── Retry / streaming ──
ATLAS_PROXY_MAX_RETRIES=5
STREAM_FIRST_BYTE_TIMEOUT=20.0
ATLAS_PROXY_KEEPALIVE_SECONDS=15.0
FREE_MODEL_MAX_CONCURRENT=25   # Nvidia free-worker limit is ~32
MAX_CONCURRENT_PER_KEY=24
ATLAS_PROXY_STICKY_MAX_USES=18  # 0 = disable proactive rotation

# ── Context window safety ──
ATLAS_PROXY_MAX_INPUT_TOKENS=180000   # 0 = disable trimming
MAX_TOKEN_TRIM_KEEP_SYSTEM=1
ATLAS_MODEL_CONTEXT_WINDOW=200000

# ── Response size cap (0 = unlimited) ──
ATLAS_MAX_RESPONSE_BYTES=0

# ── System prompt override ──
SYSTEM_PROMPT_OVERRIDE_ENABLED=1
SYSTEM_PROMPT_REINFORCEMENT_ENABLED=0   # off — trips Claude Code injection detector
SYSTEM_PROMPT_STRIP_HARNESS=1           # strip non-billing harness blocks

# ── CORS ──
CORS_ORIGINS=*

# ── Payload saving ──
ATLAS_SAVE_PAYLOAD_FILES=0
ATLAS_PAYLOAD_DIR=/tmp/atlas_payloads

# ── Upstream client identity ──
ATLAS_UPSTREAM_REFERER=https://localhost:8788
ATLAS_UPSTREAM_TITLE=Atlas-Translation-Proxy

# ── Logging ──
LOG_LEVEL=INFO
LOG_JSON=0
LOG_REQUEST_ID=1

# ── Provider base URLs (override only if self-hosting) ──
ATLAS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ATLAS_NV_BASE_URL=https://integrate.api.nvidia.com/v1
